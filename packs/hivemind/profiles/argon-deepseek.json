{
  "profile_id": "argon-deepseek",
  "description": "Google Gemini 4 Argon (via $10/mo GCP Credit) Orchestrator + DeepSeek V4.1 Flash Workers (Zero ChatGPT/Claude Quota Burn)",
  "agent_models": {
    "hivemind-architect": "google/gemini-4-argon",
    "scout": "deepseek/deepseek-flash",
    "surgeon": "deepseek/deepseek-flash",
    "verifier": "deepseek/deepseek-flash",
    "auditor": "google/gemini-4-argon",
    "oracle": "openai/gpt-6-astra"
  },
  "opencode_config": {
    "$schema": "https://opencode.ai/config.json",
    "model": "google/gemini-4-argon",
    "small_model": "deepseek/deepseek-flash",
    "provider": {
      "deepseek": {
        "npm": "@ai-sdk/openai-compatible",
        "name": "DeepSeek API (Direct)",
        "options": {
          "baseURL": "https://api.deepseek.com/v1",
          "apiKey": "{env:DEEPSEEK_API_KEY}"
        },
        "models": {
          "deepseek-flash": {
            "name": "DeepSeek V4.1 Flash (Ultra-Cheap Worker)",
            "limit": {
              "context": 128000,
              "output": 32000
            }
          },
          "deepseek-v4-pro": {
            "name": "DeepSeek V4 Pro (Reasoning Escalation)",
            "limit": {
              "context": 128000,
              "output": 64000
            }
          },
          "deepseek-chat": {
            "name": "DeepSeek Chat Alias",
            "limit": {
              "context": 128000,
              "output": 32000
            }
          }
        }
      }
    },
    "agent": {
      "plan": {
        "model": "google/gemini-4-argon"
      },
      "build": {
        "model": "deepseek/deepseek-flash"
      },
      "explore": {
        "model": "deepseek/deepseek-flash"
      }
    },
    "plugins": [
      "opencode-openai-codex-auth",
      "@ex-machina/opencode-anthropic-auth"
    ]
  }
}
