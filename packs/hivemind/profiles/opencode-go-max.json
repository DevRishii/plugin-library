{
  "profile_id": "opencode-go-max",
  "description": "OpenCode Go ($10/mo) High-Volume Worker Pool (GLM-5.3-Flash + DeepSeek V4.1 Flash) paired with GPT-6.1 Sol / Claude Opus 5.5",
  "agent_models": {
    "hivemind-architect": "openai/gpt-6.1-sol",
    "scout": "opencode-go/deepseek-v4.1-flash",
    "surgeon": "opencode-go/glm-5.3-flash",
    "verifier": "opencode-go/deepseek-v4.1-flash",
    "auditor": "openai/gpt-6.1-sol",
    "oracle": "openai/gpt-6-astra"
  },
  "opencode_config": {
    "$schema": "https://opencode.ai/config.json",
    "model": "openai/gpt-6.1-sol",
    "small_model": "opencode-go/deepseek-v4.1-flash",
    "provider": {
      "deepseek": {
        "npm": "@ai-sdk/openai-compatible",
        "name": "DeepSeek API (Direct)",
        "options": {
          "baseURL": "https://api.deepseek.com/v1",
          "apiKey": "{env:DEEPSEEK_API_KEY}"
        },
        "models": {
          "deepseek-flash": {
            "name": "DeepSeek V4.1 Flash (Ultra-Cheap Worker)",
            "limit": {
              "context": 128000,
              "output": 32000
            }
          },
          "deepseek-v4-pro": {
            "name": "DeepSeek V4 Pro (Reasoning Escalation)",
            "limit": {
              "context": 128000,
              "output": 64000
            }
          },
          "deepseek-chat": {
            "name": "DeepSeek Chat Alias",
            "limit": {
              "context": 128000,
              "output": 32000
            }
          }
        }
      }
    },
    "agent": {
      "plan": {
        "model": "openai/gpt-6.1-sol",
        "reasoningEffort": "medium"
      },
      "build": {
        "model": "opencode-go/glm-5.3-flash"
      },
      "explore": {
        "model": "opencode-go/deepseek-v4.1-flash"
      }
    },
    "plugins": [
      "opencode-openai-codex-auth",
      "@ex-machina/opencode-anthropic-auth"
    ]
  }
}
