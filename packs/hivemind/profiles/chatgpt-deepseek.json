{
  "profile_id": "chatgpt-deepseek",
  "description": "ChatGPT Plus OAuth Orchestrator (GPT-6.1 Sol / GPT-6 Astra) + DeepSeek V4.1 Flash API Workers ($0 extra subscription cost)",
  "agent_models": {
    "hivemind-architect": "openai/gpt-6.1-sol",
    "scout": "deepseek/deepseek-flash",
    "surgeon": "deepseek/deepseek-flash",
    "verifier": "deepseek/deepseek-flash",
    "auditor": "openai/gpt-6.1-sol",
    "oracle": "openai/gpt-6-astra"
  },
  "opencode_config": {
    "$schema": "https://opencode.ai/config.json",
    "model": "openai/gpt-6.1-sol",
    "small_model": "deepseek/deepseek-flash",
    "provider": {
      "deepseek": {
        "npm": "@ai-sdk/openai-compatible",
        "name": "DeepSeek API (Direct)",
        "options": {
          "baseURL": "https://api.deepseek.com/v1",
          "apiKey": "{env:DEEPSEEK_API_KEY}"
        },
        "models": {
          "deepseek-flash": {
            "name": "DeepSeek V4.1 Flash (Ultra-Cheap Worker)",
            "limit": {
              "context": 128000,
              "output": 32000
            }
          },
          "deepseek-v4-pro": {
            "name": "DeepSeek V4 Pro (Reasoning Escalation)",
            "limit": {
              "context": 128000,
              "output": 64000
            }
          },
          "deepseek-chat": {
            "name": "DeepSeek Chat Alias",
            "limit": {
              "context": 128000,
              "output": 32000
            }
          }
        }
      }
    },
    "agent": {
      "plan": {
        "model": "openai/gpt-6.1-sol",
        "reasoningEffort": "medium"
      },
      "build": {
        "model": "deepseek/deepseek-flash"
      },
      "explore": {
        "model": "deepseek/deepseek-flash"
      }
    },
    "plugins": [
      "opencode-openai-codex-auth",
      "@ex-machina/opencode-anthropic-auth"
    ]
  }
}
