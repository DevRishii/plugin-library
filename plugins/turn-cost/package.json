{
  "name": "@local/turn-cost",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "description": "Shows an estimated session API cost in the composer statistics row, with a refreshable breakdown priced from published DeepSeek, Gemini, Claude, and OpenAI rates.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-chat"]
    }
  }
}
