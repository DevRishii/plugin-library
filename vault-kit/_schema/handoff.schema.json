{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-vault.local/schemas/vault/handoff.schema.json",
  "title": "Context Vault Run Handoff Note",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "type",
    "status",
    "owner",
    "run",
    "slice",
    "files_changed",
    "tests_run",
    "decisions",
    "blockers",
    "updated"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "type": { "type": "string", "const": "handoff" },
    "status": {
      "type": "string",
      "enum": ["planned", "in_progress", "done", "blocked", "failed"]
    },
    "owner": {
      "type": "string",
      "enum": ["architect", "builder", "verifier", "auditor", "human", "librarian"]
    },
    "run": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_-]|\\.[A-Za-z0-9_-]){0,39}$"
    },
    "slice": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "files_changed": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tests_run": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "decisions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 280 },
    "tags": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" }
    }
  },
  "x_body_constraints": {
    "max_estimated_tokens": 400,
    "max_bullets": 5,
    "forbid_fenced_code_blocks": true
  }
}
