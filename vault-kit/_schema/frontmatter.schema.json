{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-vault.local/schemas/vault/frontmatter.schema.json",
  "title": "Context Vault Note Frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "type", "status", "owner", "updated"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "type": {
      "type": "string",
      "enum": ["moc", "map", "contract", "slice", "decision", "runbook", "handoff"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "draft", "superseded", "planned", "in_progress", "done", "blocked", "failed"]
    },
    "owner": {
      "type": "string",
      "enum": ["architect", "builder", "verifier", "auditor", "human", "librarian"]
    },
    "scope": {
      "type": "string",
      "enum": ["shared", "server", "web", "client", "cli", "core", "docs", "tooling", "process"]
    },
    "paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "symbols": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "contracts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "depends_on": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" }
    },
    "related": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" }
    },
    "tags": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" }
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "read_first": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "open_decisions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "run": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_-]|\\.[A-Za-z0-9_-]){0,39}$"
    },
    "slice": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "files_changed": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tests_run": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "decisions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "enum": ["contract", "slice", "map", "decision"] } }
      },
      "then": {
        "required": ["summary"]
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "handoff" } }
      },
      "then": {
        "required": ["run", "slice", "files_changed", "tests_run", "decisions", "blockers"]
      }
    }
  ]
}
