{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-vault.local/schemas/vault/index.schema.json",
  "title": "Context Vault Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "root", "source_hash", "stats", "notes", "files", "symbols"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generated_at": { "type": "string", "minLength": 20 },
    "root": { "type": "string", "const": "." },
    "source_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "notes", "symbols", "bytes"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "notes": { "type": "integer", "minimum": 0 },
        "symbols": { "type": "integer", "minimum": 0, "maximum": 20000 },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "title",
          "type",
          "status",
          "owner",
          "tags",
          "paths",
          "symbols",
          "contracts",
          "depends_on",
          "related",
          "outbound_links",
          "inbound_links",
          "broken_links",
          "summary",
          "bytes",
          "updated"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "path": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["moc", "map", "contract", "slice", "decision", "runbook"] },
          "status": { "type": "string" },
          "owner": { "type": "string" },
          "scope": { "type": ["string", "null"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "paths": { "type": "array", "items": { "type": "string" } },
          "symbols": { "type": "array", "items": { "type": "string" } },
          "contracts": { "type": "array", "items": { "type": "string" } },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "related": { "type": "array", "items": { "type": "string" } },
          "read_first": { "type": "array", "items": { "type": "string" } },
          "acceptance": { "type": "array", "items": { "type": "string" } },
          "open_decisions": { "type": "array", "items": { "type": "string" } },
          "outbound_links": { "type": "array", "items": { "type": "string" } },
          "inbound_links": { "type": "array", "items": { "type": "string" } },
          "broken_links": { "type": "array", "items": { "type": "string" } },
          "summary": { "type": "string" },
          "source_hash": { "type": ["string", "null"] },
          "bytes": { "type": "integer", "minimum": 0 },
          "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "lang",
          "bytes",
          "loc",
          "hash",
          "owner_slice",
          "exports",
          "imports",
          "notes",
          "contract_refs"
        ],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "lang": {
            "type": "string",
            "enum": ["ts", "tsx", "js", "jsx", "mjs", "cjs", "py", "go", "rs", "json", "yaml", "yml", "toml", "md", "css", "html", "sh", "ps1", "other"]
          },
          "bytes": { "type": "integer", "minimum": 0 },
          "loc": { "type": "integer", "minimum": 0 },
          "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "owner_slice": { "type": ["string", "null"] },
          "exports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "line"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "enum": ["function", "const", "class", "type", "interface", "enum"] },
                "line": { "type": "integer", "minimum": 1 },
                "end_line": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "imports": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "array", "items": { "type": "string" } },
          "contract_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "symbols": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "line", "kind", "exported"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "line": { "type": "integer", "minimum": 1 },
            "end_line": { "type": "integer", "minimum": 1 },
            "kind": { "type": "string", "enum": ["function", "const", "class", "type", "interface", "enum"] },
            "exported": { "type": "boolean" }
          }
        }
      }
    }
  }
}
